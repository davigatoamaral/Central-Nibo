          <p className="text-sm py-4" style={{ color: tokens.inkSoft }}>
            Nenhum compromisso em {formatarDataLabel(dataSelecionada).toLowerCase()} — dia livre.
          </p>
        )}
        {eventos && eventos.length > 0 && (
          <div className="flex flex-col gap-2.5">
            {eventos.map((e, i) => (
              <div key={i} className="flex items-stretch gap-3">
                <div className="w-10 text-right flex-shrink-0 pt-1.5">
                  <p className="text-xs font-semibold" style={{ color: tokens.navy }}>
                    {e.inicio}
                  </p>
