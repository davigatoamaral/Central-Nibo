function slugify(texto) {
  return texto
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

function mesclarOrdem(salvo, links) {
  const nomesAtuais = links.map((l) => l.nome);
  const preservados = salvo.filter((n) => nomesAtuais.includes(n));
  const novos = nomesAtuais.filter((n) => !preservados.includes(n));
  return [...preservados, ...novos];
}

function ListaSimples({ title, subtitle, links }) {
  const [busca, setBusca] = useState("");
  const [ordem, setOrdem] = useState(() => links.map((l) => l.nome));
  const [arrastando, setArrastando] = useState(null);
  const [carregouOrdem, setCarregouOrdem] = useState(false);

  const chaveStorage = `link-order:${slugify(title)}`;

  useEffect(() => {
    let cancelado = false;
    async function carregar() {
      try {
        const resultado = await window.storage.get(chaveStorage);
        if (!cancelado && resultado && resultado.value) {
          const salvo = JSON.parse(resultado.value);
          if (Array.isArray(salvo)) setOrdem(mesclarOrdem(salvo, links));
        }
      } catch (e) {
        // ainda não há ordem salva para esta lista — mantém a ordem padrão
      } finally {
        if (!cancelado) setCarregouOrdem(true);
      }
    }
    carregar();
    return () => {
      cancelado = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function persistirOrdem(nova) {
    try {
      await window.storage.set(chaveStorage, JSON.stringify(nova));
    } catch (e) {
      // se falhar em salvar, a ordem continua funcionando nesta sessão
    }
  }

  function soltarSobre(nomeAlvo) {
    if (!arrastando || arrastando === nomeAlvo) return;
    setOrdem((prev) => {
      const semArrastado = prev.filter((n) => n !== arrastando);
      const idxAlvo = semArrastado.indexOf(nomeAlvo);
      const novo = [...semArrastado];
      novo.splice(idxAlvo, 0, arrastando);
      persistirOrdem(novo);
      return novo;
    });
  }

  const ordenados = ordem
    .map((nome) => links.find((l) => l.nome === nome))
    .filter(Boolean);

  const filtrados = busca.trim()
    ? ordenados.filter((l) => l.nome.toLowerCase().includes(busca.toLowerCase()))
    : ordenados;

  const podeArrastar = !busca.trim();

  return (
    <div className="w-full px-8 py-8">
      <div className="flex items-end justify-between gap-4 flex-wrap">
        <div>
          <h1 className="font-display text-2xl" style={{ color: tokens.ink }}>
            {title}
          </h1>
          <p className="mt-1 text-sm" style={{ color: tokens.inkSoft }}>
            {subtitle} {podeArrastar && "Arraste os cards para reorganizar por prioridade."}
          </p>
        </div>

        {links.length > 8 && (
          <div className="relative w-56 flex-shrink-0">
            <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2" style={{ color: tokens.navySoft }} />
            <input
              value={busca}
              onChange={(e) => setBusca(e.target.value)}
              placeholder="Buscar..."
              className="w-full pl-8 pr-3 py-1.5 rounded-lg text-sm outline-none"
              style={{ backgroundColor: tokens.surface, border: `1px solid ${tokens.border}`, color: tokens.ink }}
            />
          </div>
        )}
      </div>

      {filtrados.length === 0 && (
        <p className="text-sm py-6" style={{ color: tokens.inkSoft }}>
          Nada encontrado para "{busca}".
        </p>
      )}

      <div className="mt-5 grid gap-2.5" style={{ gridTemplateColumns: "repeat(auto-fill, minmax(210px, 1fr))" }}>
        {filtrados.map((l) => (
          <a
            key={l.nome}
            href={l.url}
            target="_blank"
            rel="noreferrer"
            draggable={podeArrastar}
            onDragStart={(e) => {
              setArrastando(l.nome);
              e.dataTransfer.effectAllowed = "move";
            }}
            onDragOver={(e) => {
              if (podeArrastar) e.preventDefault();
            }}
            onDrop={(e) => {
              e.preventDefault();
              soltarSobre(l.nome);
              setArrastando(null);
            }}
            onDragEnd={() => setArrastando(null)}
            className="flex items-center gap-1.5 rounded-lg pl-1.5 pr-3.5 py-3 text-sm transition-colors group"
            style={{
              backgroundColor: tokens.surface,
              border: `1px solid ${tokens.border}`,
              color: tokens.ink,
              opacity: arrastando === l.nome ? 0.4 : 1,
              cursor: podeArrastar ? "grab" : "pointer",
            }}
          >
            {podeArrastar && (
              <GripVertical
                size={13}
                className="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                style={{ color: tokens.navySoft }}
              />
            )}
            <span className="truncate flex-1">{l.nome}</span>
            <ExternalLink
              size={13}
              className="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
              style={{ color: tokens.navySoft }}
            />
          </a>
        ))}
      </div>
    </div>
  );
}

