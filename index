  );
}

async function chamarClaudeAPI(prompt, mcpServers = [], maxTokens = 4000) {
  const body = {
    model: "claude-sonnet-4-6",
    max_tokens: maxTokens,
    messages: [{ role: "user", content: prompt }],
  };
  if (mcpServers.length) body.mcp_servers = mcpServers;

  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  if (!response.ok) {
    let detalhe = "";
    try {
      const errJson = await response.json();
      detalhe = errJson?.error?.message || JSON.stringify(errJson);
    } catch (e2) {
      detalhe = await response.text().catch(() => "");
    }
    throw new Error(`Erro ${response.status}${detalhe ? ": " + detalhe : ""}`);
  }
  return response.json();
}

// Se a resposta foi cortada no meio de um array JSON (limite de tokens), aproveita os
// objetos que vieram completos em vez de descartar tudo.
function repararArrayJSON(texto) {
  const s = texto.trim();
  if (!s.startsWith("[")) return null;
  let depth = 0;
  let ultimoFechamento = -1;
  let dentroString = false;
  let escapando = false;
  for (let i = 0; i < s.length; i++) {
    const ch = s[i];
    if (escapando) {
      escapando = false;
      continue;
    }
    if (ch === "\\") {
      escapando = true;
      continue;
    }
    if (ch === '"') {
      dentroString = !dentroString;
      continue;
    }
    if (dentroString) continue;
    if (ch === "{") depth++;
    if (ch === "}") {
      depth--;
      if (depth === 0) ultimoFechamento = i;
    }
  }
  if (ultimoFechamento === -1) return null;
  const reparado = s.slice(0, ultimoFechamento + 1) + "]";
  try {
    return JSON.parse(reparado);
  } catch (e) {
    return null;
  }
}

function extrairTextoResposta(data) {
  return (data.content || [])
    .filter((b) => b.type === "text")
    .map((b) => b.text)
    .join("\n")
    .replace(/```json|```/g, "")
    .trim();
}

