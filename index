                <div className="w-0.5 rounded-full flex-shrink-0" style={{ backgroundColor: tokens.navy }} />
                <div
                  className="flex-1 rounded-md px-4 py-2.5 flex items-center justify-between gap-2"
                  style={{ border: `1px solid ${tokens.border}` }}
                >
                  <span className="text-sm font-semibold" style={{ color: tokens.navy }}>
                    {e.titulo}
                  </span>
                  {e.link && (
                    <a
                      href={e.link}
                      target="_blank"
                      rel="noreferrer"
                      className="text-xs font-medium flex-shrink-0"
                      style={{ color: tokens.brand }}
                    >
                      Entrar
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}

        {mensagem && (
          <p className="text-xs mt-3" style={{ color: mensagem.ok ? tokens.brand : tokens.red }}>
            {mensagem.texto}
          </p>
        )}
      </div>

      <NovaReuniaoModal
        aberto={modalAberto}
        onFechar={() => setModalAberto(false)}
