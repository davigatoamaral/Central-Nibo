function GoogleAgendaCard() {
  const [dataSelecionada, setDataSelecionada] = useState(new Date());
  const [eventos, setEventos] = useState(null);
  const [carregando, setCarregando] = useState(false);
  const [erro, setErro] = useState(null);
  const [modalAberto, setModalAberto] = useState(false);
  const [criando, setCriando] = useState(false);
  const [erroModal, setErroModal] = useState(null);
  const [mensagem, setMensagem] = useState(null);

  async function chamarClaude(prompt) {
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        messages: [{ role: "user", content: prompt }],
        mcp_servers: [
          { type: "url", url: "https://calendarmcp.googleapis.com/mcp/v1", name: "google-calendar" },
        ],
      }),
    });
    if (!response.ok) throw new Error("Falha ao conectar com a Google Agenda");
    return response.json();
  }

  function extrairTexto(data) {
    return (data.content || [])
      .filter((b) => b.type === "text")
      .map((b) => b.text)
      .join("\n")
      .replace(/```json|```/g, "")
      .trim();
  }

  async function carregarAgenda(data) {
    setCarregando(true);
    setErro(null);
    try {
      const dataFmt = data.toLocaleDateString("pt-BR", {
        weekday: "long",
        day: "2-digit",
        month: "long",
        year: "numeric",
      });
      const resposta = await chamarClaude(
        `Considere a data ${dataFmt} (${paraInputDate(data)}). Liste meus compromissos NESSA data na minha Google Agenda principal, em ordem cronológica. Responda APENAS com um array JSON, sem nenhum texto antes ou depois, no formato [{"inicio":"09:00","fim":"09:30","titulo":"...","link":"..."}]. Use link vazio ("") quando não houver videochamada. Se não houver nenhum compromisso nessa data, responda [].`
      );
      const texto = extrairTexto(resposta);
      const parsed = JSON.parse(texto);
      setEventos(Array.isArray(parsed) ? parsed : []);
    } catch (e) {
      setErro("Não consegui carregar sua Google Agenda agora. Verifique se ela está conectada em Configurações.");
      setEventos(null);
    } finally {
      setCarregando(false);
    }
  }

  async function criarReuniao({ titulo, data, inicio, fim, emails, criarMeet }) {
    setCriando(true);
    setErroModal(null);
    try {
      const dataObj = new Date(...data.split("-").map((n, i) => (i === 1 ? Number(n) - 1 : Number(n))));
      const dataFmt = dataObj.toLocaleDateString("pt-BR", {
        weekday: "long",
        day: "2-digit",
        month: "long",
        year: "numeric",
      });
      const listaEmails = emails
        .split(",")
        .map((e) => e.trim())
        .filter(Boolean);

      const prompt = `Crie um evento na minha Google Agenda principal com estes dados exatos:
- Título: ${titulo}
- Data: ${dataFmt} (${data})
- Início: ${inicio}
- Fim: ${fim || "uma hora depois do início"}
${listaEmails.length ? `- Convidados: ${listaEmails.join(", ")}` : "- Sem convidados além de mim"}
${criarMeet ? "- Inclua uma videochamada do Google Meet no evento, para os convidados entrarem." : "- Não é necessário criar videochamada."}
Depois de criar, responda APENAS com um JSON, sem texto antes ou depois, no formato {"criado":true,"titulo":"...","inicio":"...","meetLink":"..."} (meetLink vazio se não foi criado) ou, se não conseguir criar, {"criado":false,"motivo":"..."}.`;

      const resposta = await chamarClaude(prompt);
      const texto = extrairTexto(resposta);
      const parsed = JSON.parse(texto);

      if (parsed.criado) {
        setMensagem({
          ok: true,
          texto: `Reunião "${parsed.titulo}" salva às ${parsed.inicio}${
            parsed.meetLink ? " — link do Meet incluído no convite" : ""
          }.`,
        });
        setModalAberto(false);
        if (mesmoDia(dataObj, dataSelecionada)) {
          carregarAgenda(dataSelecionada);
        } else {
          setDataSelecionada(dataObj);
        }
      } else {
        setErroModal(parsed.motivo || "Não consegui criar a reunião agora.");
      }
    } catch (e) {
      setErroModal("Não consegui falar com a Google Agenda agora.");
    } finally {
      setCriando(false);
    }
  }

  useEffect(() => {
    carregarAgenda(dataSelecionada);
  }, [dataSelecionada]);

  const semana = getSemana(dataSelecionada);
  const hoje = new Date();

  return (
    <div className="rounded-lg overflow-hidden col-span-2" style={{ border: `1px solid ${tokens.border}` }}>
      {/* Cabeçalho */}
      <div className="flex items-center justify-between px-5 py-4" style={{ backgroundColor: tokens.navy }}>
        <div className="flex items-center gap-2">
          <CalendarDays size={16} color="white" />
          <p className="text-sm font-semibold text-white">Google Agenda ({formatarDataLabel(dataSelecionada)})</p>
        </div>
        <button
          onClick={() => setModalAberto(true)}
          className="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-md"
          style={{ backgroundColor: "white", color: tokens.navy }}
        >
          <Plus size={13} />
          Agendar
        </button>
      </div>

      <div className="p-5" style={{ backgroundColor: tokens.surface }}>
        {/* Tira de dias da semana */}
        <div className="grid grid-cols-7 gap-1 mb-5">
          {semana.map((d) => {
            const selecionado = mesmoDia(d, dataSelecionada);
            return (
              <button key={d.toISOString()} onClick={() => setDataSelecionada(d)} className="flex flex-col items-center gap-1.5 py-1">
                <span className="text-xs font-medium" style={{ color: tokens.amber }}>
                  {diasAbrev[d.getDay()]}
                </span>
                <span
                  className="w-7 h-7 flex items-center justify-center rounded-full text-xs font-semibold"
                  style={{
                    backgroundColor: selecionado ? tokens.navy : "transparent",
                    color: selecionado ? "white" : mesmoDia(d, hoje) ? tokens.navy : tokens.inkSoft,
                  }}
                >
                  {d.getDate()}
                </span>
              </button>
            );
          })}
        </div>

        {/* Lista de compromissos */}
        <div className="flex items-center gap-2 mb-2">
          <button onClick={() => carregarAgenda(dataSelecionada)} title="Atualizar" style={{ color: tokens.navySoft }}>
            <RefreshCw size={13} style={{ animation: carregando ? "spin 1s linear infinite" : "none" }} />
          </button>
          <span className="text-xs" style={{ color: tokens.inkSoft }}>
            {carregando ? "Atualizando..." : "Atualizado agora"}
          </span>
        </div>

        {carregando && eventos === null && (
          <p className="text-sm py-4" style={{ color: tokens.inkSoft }}>
            Carregando compromissos...
          </p>
        )}
        {erro && (
          <p className="text-sm py-4" style={{ color: tokens.red }}>
