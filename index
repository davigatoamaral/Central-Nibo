<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Malha — Reuniões transcritas</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
  :root {
    --bg: #F4F6FA; --surface: #FFFFFF; --surface-alt: #EEF2F8; --border: #DDE3ED;
    --ink: #1C2420; --ink-soft: #5B6560; --navy: #12285B; --navy-soft: #5C6E93;
    --brand-soft: #E1E7F2; --indigo: #46538F; --indigo-soft: #E2E5F3;
    --amber: #B9793A; --amber-soft: #F3E4D0; --red: #9B3B3B; --red-soft: #F1DEDE;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: -apple-system, "Segoe UI", Inter, Arial, sans-serif; background: var(--bg); color: var(--ink); }
  .topo {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 24px; background: var(--navy); color: white;
  }
  .topo h1 { font-size: 15px; margin: 0; font-weight: 600; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px; border: none; border-radius: 8px;
    padding: 9px 15px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit;
  }
  .btn-branco { background: white; color: var(--navy); }
  .btn-primario { background: var(--navy); color: white; }
  .btn-secundario { background: var(--brand-soft); color: var(--navy); }
  .btn:disabled { opacity: .6; cursor: not-allowed; }

  .gate {
    max-width: 420px; margin: 80px auto; text-align: center; background: var(--surface);
    border: 1px solid var(--border); border-radius: 12px; padding: 40px 28px;
  }
  .gate p { color: var(--ink-soft); font-size: 14px; margin-bottom: 20px; }

  .app { display: none; }
  .app.ativo { display: flex; min-height: calc(100vh - 50px); }
  .lista { width: 320px; flex-shrink: 0; padding: 24px 16px; border-right: 1px solid var(--border); background: var(--surface); }
  .lista h2 { font-size: 18px; margin: 0 0 4px; }
  .lista .subtitulo { font-size: 13px; color: var(--ink-soft); margin: 0 0 20px; }
  .arquivo {
    display: block; width: 100%; text-align: left; background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; cursor: pointer; font-family: inherit;
  }
  .arquivo:hover { border-color: var(--navy); }
  .arquivo.ativo { background: var(--brand-soft); border-color: var(--navy); }
  .arquivo .nome { font-size: 13px; font-weight: 600; color: var(--ink); }
  .arquivo .meta { font-size: 11px; color: var(--ink-soft); margin-top: 3px; }
  .badge { display: inline-block; margin-top: 6px; font-size: 11px; padding: 2px 8px; border-radius: 999px; }
  .badge.naoAberto { background: var(--surface-alt); color: var(--ink-soft); }
  .badge.carregando { background: var(--amber-soft); color: var(--amber); }
  .badge.revisao { background: var(--indigo-soft); color: var(--indigo); }
  .badge.enviado { background: var(--brand-soft); color: var(--navy); }

  .detalhe { flex: 1; padding: 24px 32px; overflow-y: auto; }
  .vazio { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 80px 20px; text-align: center; color: var(--ink-soft); font-size: 14px; }
  .transcricao { background: var(--surface-alt); color: var(--ink-soft); border-radius: 10px; padding: 14px 16px; font-size: 13px; line-height: 1.6; max-height: 160px; overflow-y: auto; white-space: pre-line; margin-bottom: 16px; }

  .colunas { display: grid; grid-template-columns: 1fr 1fr 0.85fr; gap: 24px; margin-top: 20px; }
  .campo { margin-bottom: 12px; }
  .campo label { display: block; font-size: 11px; font-weight: 600; color: var(--navy); margin-bottom: 4px; }
  .campo input, .campo textarea {
    width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px;
    font-size: 13px; font-family: inherit; background: var(--surface); color: var(--ink); resize: vertical;
  }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .toggle-linha { display: flex; align-items: center; gap: 10px; background: var(--surface-alt); border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; cursor: pointer; }
  .toggle-linha.ativo { background: var(--brand-soft); }
  .toggle { width: 34px; height: 20px; border-radius: 999px; background: var(--border); position: relative; flex-shrink: 0; transition: background .15s; }
  .toggle.ativo { background: var(--navy); }
  .toggle .bola { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 999px; background: white; transition: transform .15s; }
  .toggle.ativo .bola { transform: translateX(14px); }
  .toggle-texto strong { display: block; font-size: 12px; color: var(--navy); }
  .toggle-texto span { font-size: 11px; color: var(--ink-soft); }

  .passo { display: flex; align-items: flex-start; gap: 8px; padding: 6px 4px; cursor: pointer; font-size: 13px; }
  .passo input { margin-top: 2px; }
  .passo.feito { color: var(--ink-soft); text-decoration: line-through; }

  .erro { color: var(--red); font-size: 13px; margin: 10px 0; }
  .aviso { color: var(--ink-soft); font-size: 12px; margin-top: 8px; }
  .copiar { background: none; border: none; cursor: pointer; font-size: 11px; color: var(--navy-soft); display: inline-flex; align-items: center; gap: 4px; }
  .copiar.ok { color: #2F6657; }
</style>
</head>
<body>

  <div class="topo">
    <h1>Malha — Reuniões transcritas</h1>
    <div id="areaConta"></div>
  </div>

  <div class="gate" id="gate">
    <p>Conecte sua conta Google para ler as transcrições da pasta do Drive.</p>
    <button class="btn btn-primario" id="btnConectar">Conectar com Google Drive</button>
    <p class="erro" id="erroConexao" style="display:none;"></p>
  </div>

  <div class="app" id="app">
    <div class="lista">
      <h2>Reuniões transcritas</h2>
      <p class="subtitulo">Lidas direto da pasta do Drive · últimos 30 dias</p>
      <div id="statusLista" style="font-size:13px;color:var(--ink-soft);"></div>
      <div id="listaArquivos"></div>
    </div>
    <div class="detalhe" id="detalhe">
      <div class="vazio">Escolha um arquivo transcrito à esquerda para gerar o resumo comercial.</div>
    </div>
  </div>

<script>
  // ------------------------------------------------------------------
  // CONFIGURAÇÃO — preencha antes de publicar no GitHub Pages
  // ------------------------------------------------------------------
  const CONFIG = {
    // Client ID OAuth (tipo "Web application") criado no Google Cloud Console.
    CLIENT_ID: 'SEU_CLIENT_ID_AQUI.apps.googleusercontent.com',
    // Chave do Gemini gerada em aistudio.google.com/apikey.
    // IMPORTANTE: restrinja essa chave por domínio (HTTP referrer) no Google Cloud
    // Console, apontando para a URL do seu GitHub Pages — veja o LEIA-ME.
    GEMINI_API_KEY: 'SUA_CHAVE_GEMINI_AQUI',
    PASTA_ID: '1rTqu1-yFH8JneSBBETwuYYV8ZSGsiaFb',
    MODELO_GEMINI: 'gemini-3.5-flash-lite',
  };
  // ------------------------------------------------------------------

  let tokenAcesso = null;
  let arquivos = [];
  let statusPorArquivo = {};
  let selecionado = null;
  let transcricaoAtual = null;
  let resumoAtual = null;
  let passosAtuais = [];
  let enviado = false;

  function iniciarLogin() {
    const client = google.accounts.oauth2.initTokenClient({
      client_id: CONFIG.CLIENT_ID,
      scope: 'https://www.googleapis.com/auth/drive.readonly',
      callback: function (resposta) {
        if (resposta.error) {
          mostrarErroConexao('Login recusado: ' + resposta.error);
          return;
        }
        tokenAcesso = resposta.access_token;
        document.getElementById('gate').style.display = 'none';
        document.getElementById('app').classList.add('ativo');
        document.getElementById('areaConta').innerHTML =
          '<button class="btn btn-branco" onclick="location.reload()">Sair</button>';
        carregarLista();
      },
    });
    client.requestAccessToken();
  }

  function mostrarErroConexao(msg) {
    const el = document.getElementById('erroConexao');
    el.style.display = 'block';
    el.textContent = msg;
  }

  document.getElementById('btnConectar').onclick = iniciarLogin;

  // ---------------- Google Drive ----------------

  async function listarArquivosRecentes() {
    const limite = new Date();
    limite.setDate(limite.getDate() - 30);
    const limiteISO = limite.toISOString();

    const q = "'" + CONFIG.PASTA_ID + "' in parents and trashed = false and modifiedTime > '" + limiteISO + "'";
    const url = 'https://www.googleapis.com/drive/v3/files' +
      '?q=' + encodeURIComponent(q) +
      '&fields=' + encodeURIComponent('files(id,name,modifiedTime,mimeType)') +
      '&orderBy=modifiedTime desc&pageSize=25';

    const resp = await fetch(url, { headers: { Authorization: 'Bearer ' + tokenAcesso } });
    if (!resp.ok) {
      const corpo = await resp.text();
      throw new Error('Erro ' + resp.status + ' do Google Drive: ' + corpo.slice(0, 200));
    }
    const dados = await resp.json();
    return (dados.files || []).map(function (f) {
      return {
        id: f.id,
        nome: f.name,
        mimeType: f.mimeType,
        modificadoTexto: new Date(f.modifiedTime).toLocaleDateString('pt-BR'),
      };
    });
  }

  async function lerConteudoArquivo(id, mimeType) {
    let url;
    if (mimeType === 'application/vnd.google-apps.document') {
      url = 'https://www.googleapis.com/drive/v3/files/' + id + '/export?mimeType=text/plain';
    } else {
      url = 'https://www.googleapis.com/drive/v3/files/' + id + '?alt=media';
    }
    const resp = await fetch(url, { headers: { Authorization: 'Bearer ' + tokenAcesso } });
    if (!resp.ok) {
      const corpo = await resp.text();
      throw new Error('Erro ' + resp.status + ' ao ler o arquivo: ' + corpo.slice(0, 200));
    }
    return resp.text();
  }

  // ---------------- Gemini ----------------

  async function gerarResumoComercialAPI(transcricao) {
    const prompt =
      'Você é um analista comercial. Abaixo está a transcrição de uma reunião comercial de ' +
      'vendas de um produto de Gestão Financeira / BPO financeiro (Nibo). Extraia as ' +
      'informações comerciais discutidas e monte um resumo estruturado.\n\n' +
      'Transcrição:\n"""\n' + transcricao + '\n"""\n\n' +
      'Responda APENAS com um JSON no formato exato abaixo (sem markdown, sem texto fora do JSON):\n' +
      '{\n' +
      '  "resumoExecutivo": "resumo objetivo de 2 a 3 frases sobre a reunião",\n' +
      '  "orcamento": {"tipo": "Gestão Financeira, BPO, ou Gestão Financeira + BPO, ou Não definido", ' +
      '"mensalidade": "valor da mensalidade e para quantos clientes/CNPJs, ex: R$ 450 para até 10 clientes", ' +
      '"qtdClientes": "quantidade de clientes ou CNPJs mencionada, ou Não mencionado"},\n' +
      '  "isencaoMensalidade": {"temIsencao": true ou false, "detalhe": "explicação da isenção, ou Não mencionado"},\n' +
      '  "taxaImplantacao": "valor e condições da taxa de implantação, ou Não mencionada",\n' +
      '  "dataLimiteOrcamento": "data limite para o cliente decidir sobre o orçamento, ou Não mencionada",\n' +
      '  "descontoCondicaoEspecial": "descreva qualquer desconto, gestão financeira gratuita, ou funcionalidade ' +
      'do plano premium incluída no plano plus, ou Nenhuma condição especial",\n' +
      '  "mensagemCliente": "mensagem pronta para enviar ao cliente pelo WhatsApp, seguindo EXATAMENTE este ' +
      'modelo:\\n\\nFormalizando nossa proposta de [Nibo BPO ou Gestão Financeira] para [X empresas/CNPJs] com ' +
      'fechamento até o dia [data]:\\n\\n• [condição exclusiva — isenção de mensalidade, só se foi oferecida]\\n' +
      '• Taxa de implantação de R$ [valor], dividido em 3x sem juros [só se a taxa foi mencionada]\\n' +
      '• Gestão financeira gratuita [só se foi oferecida]\\n' +
      '• Mensalidade de R$ [valor] para [X] clientes, no plano [Plus ou Premium] [se não ficou definido qual ' +
      'plano, informe os dois valores]\\n\\nOmita qualquer marcador cujo dado não tenha sido mencionado na ' +
      'reunião. Tom cordial e comercial, pronto para colar no WhatsApp.",\n' +
      '  "proximosPassos": ["passo objetivo e curto 1", "passo objetivo e curto 2"]\n' +
      '}\n' +
      'Use exatamente os valores default indicados (ex: "Não mencionado") quando a informação não aparecer ' +
      'na transcrição — não invente dados.';

    const url = 'https://generativelanguage.googleapis.com/v1beta/models/' + CONFIG.MODELO_GEMINI + ':generateContent';
    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-goog-api-key': CONFIG.GEMINI_API_KEY },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: { responseMimeType: 'application/json' },
      }),
    });
    if (!resp.ok) {
      const corpo = await resp.text();
      throw new Error('Erro ' + resp.status + ' do Gemini: ' + corpo.slice(0, 200));
    }
    const dados = await resp.json();
    const texto = dados.candidates && dados.candidates[0] && dados.candidates[0].content.parts[0].text;
    if (!texto) throw new Error('O Gemini não retornou conteúdo.');
    return JSON.parse(texto);
  }

  // ---------------- UI ----------------

  function carregarLista() {
    document.getElementById('statusLista').textContent = 'Lendo a pasta do Drive...';
    listarArquivosRecentes()
      .then(function (lista) {
        arquivos = lista;
        document.getElementById('statusLista').textContent =
          lista.length === 0 ? 'Nenhum arquivo modificado nos últimos 30 dias.' : '';
        renderizarLista();
      })
      .catch(function (erro) {
        document.getElementById('statusLista').innerHTML =
          '<span style="color:var(--red)">' + erro.message + '</span>';
      });
  }

  function renderizarLista() {
    const container = document.getElementById('listaArquivos');
    container.innerHTML = '';
    arquivos.forEach(function (a) {
      const status = statusPorArquivo[a.id] || 'naoAberto';
      const label = { naoAberto: 'Não aberto', carregando: 'Lendo transcrição...', revisao: 'Aguardando revisão', enviado: 'Enviado ao cliente' }[status];
      const btn = document.createElement('button');
      btn.className = 'arquivo' + (selecionado && selecionado.id === a.id ? ' ativo' : '');
      btn.innerHTML =
        '<div class="nome">' + escaparHtml(a.nome) + '</div>' +
        '<div class="meta">Modificado em ' + a.modificadoTexto + '</div>' +
        '<span class="badge ' + status + '">' + label + '</span>';
      btn.onclick = function () { abrirArquivo(a); };
      container.appendChild(btn);
    });
  }

  function escaparHtml(texto) {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  function abrirArquivo(arquivo) {
    selecionado = arquivo;
    transcricaoAtual = null;
    resumoAtual = null;
    passosAtuais = [];
    enviado = false;
    statusPorArquivo[arquivo.id] = 'carregando';
    renderizarLista();
    renderizarDetalhe();

    lerConteudoArquivo(arquivo.id, arquivo.mimeType)
      .then(function (texto) {
        transcricaoAtual = texto;
        statusPorArquivo[arquivo.id] = 'revisao';
        renderizarLista();
        renderizarDetalhe();
      })
      .catch(function (erro) {
        statusPorArquivo[arquivo.id] = 'naoAberto';
        renderizarLista();
        renderizarDetalhe(erro.message);
      });
  }

  function gerarResumo() {
    const botao = document.getElementById('btnGerarResumo');
    if (botao) { botao.disabled = true; botao.textContent = 'Extraindo dados comerciais...'; }
    gerarResumoComercialAPI(transcricaoAtual)
      .then(function (resumo) {
        resumoAtual = resumo;
        passosAtuais = (resumo.proximosPassos || []).map(function (texto, i) {
          return { id: i, texto: texto, feito: false };
        });
        renderizarDetalhe();
      })
      .catch(function (erro) {
        renderizarDetalhe(null, 'Não consegui extrair os dados comerciais: ' + erro.message);
      });
  }

  function aprovarEnviar() {
    enviado = true;
    if (selecionado) statusPorArquivo[selecionado.id] = 'enviado';
    renderizarLista();
    renderizarDetalhe();
  }

  function copiarTexto(texto, botaoId) {
    navigator.clipboard.writeText(texto).then(function () {
      const b = document.getElementById(botaoId);
      if (b) {
        const original = b.textContent;
        b.textContent = 'Copiado!';
        b.classList.add('ok');
        setTimeout(function () { b.textContent = original; b.classList.remove('ok'); }, 1500);
      }
    });
  }

  function atualizarCampoResumo(caminho, valor) {
    if (caminho.length === 1) resumoAtual[caminho[0]] = valor;
    else resumoAtual[caminho[0]][caminho[1]] = valor;
  }

  function renderizarDetalhe(erroTranscricao, erroResumo) {
    const el = document.getElementById('detalhe');
    if (!selecionado) { el.innerHTML = '<div class="vazio">Escolha um arquivo transcrito à esquerda para gerar o resumo comercial.</div>'; return; }
    if (erroTranscricao) { el.innerHTML = '<div class="erro">' + escaparHtml(erroTranscricao) + '</div>'; return; }
    if (!transcricaoAtual) { el.innerHTML = '<div class="vazio">Lendo transcrição de "' + escaparHtml(selecionado.nome) + '"...</div>'; return; }

    let html = '<div class="transcricao">' + escaparHtml(transcricaoAtual.slice(0, 1200)) + (transcricaoAtual.length > 1200 ? '...' : '') + '</div>';

    if (!resumoAtual) {
      html += '<button class="btn btn-primario" id="btnGerarResumo" onclick="gerarResumo()">Gerar resumo comercial</button>';
      if (erroResumo) html += '<div class="erro">' + escaparHtml(erroResumo) + '</div>';
      el.innerHTML = html;
      return;
    }

    const r = resumoAtual;
    const dis = enviado ? 'disabled' : '';

    html += '<div class="colunas">';
    html += '<div>';
    html += '<div class="campo"><label>Resumo executivo</label><textarea rows="4" ' + dis + ' oninput="atualizarCampoResumo([\'resumoExecutivo\'], this.value)">' + escaparHtml(r.resumoExecutivo) + '</textarea></div>';
    html += '<div class="grid2">';
    html += '<div class="campo"><label>Orçamento — tipo</label><input ' + dis + ' oninput="atualizarCampoResumo([\'orcamento\',\'tipo\'], this.value)" value="' + escaparHtml(r.orcamento.tipo) + '"></div>';
    html += '<div class="campo"><label>Mensalidade</label><input ' + dis + ' oninput="atualizarCampoResumo([\'orcamento\',\'mensalidade\'], this.value)" value="' + escaparHtml(r.orcamento.mensalidade) + '"></div>';
    html += '</div>';
    html += '<div class="toggle-linha' + (r.isencaoMensalidade.temIsencao ? ' ativo' : '') + '" onclick="' +
      (enviado ? '' : 'this.querySelector(\'.toggle\').classList.toggle(\'ativo\'); atualizarCampoResumo([\'isencaoMensalidade\',\'temIsencao\'], this.querySelector(\'.toggle\').classList.contains(\'ativo\'));') + '">' +
      '<div class="toggle' + (r.isencaoMensalidade.temIsencao ? ' ativo' : '') + '"><div class="bola"></div></div>' +
      '<div class="toggle-texto"><strong>Isenção de mensalidade</strong><span>' + escaparHtml(r.isencaoMensalidade.detalhe) + '</span></div></div>';
    html += '<div class="grid2">';
    html += '<div class="campo"><label>Taxa de implantação</label><input ' + dis + ' oninput="atualizarCampoResumo([\'taxaImplantacao\'], this.value)" value="' + escaparHtml(r.taxaImplantacao) + '"></div>';
    html += '<div class="campo"><label>Data limite</label><input ' + dis + ' oninput="atualizarCampoResumo([\'dataLimiteOrcamento\'], this.value)" value="' + escaparHtml(r.dataLimiteOrcamento) + '"></div>';
    html += '</div>';
    html += '<div class="campo"><label>Desconto ou condição especial</label><textarea rows="3" ' + dis + ' oninput="atualizarCampoResumo([\'descontoCondicaoEspecial\'], this.value)">' + escaparHtml(r.descontoCondicaoEspecial) + '</textarea></div>';
    html += '</div>';

    html += '<div>';
    html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;"><label style="font-size:11px;font-weight:600;color:var(--navy);">Mensagem para o cliente (WhatsApp)</label><button class="copiar" id="btnCopiarMsg" onclick="copiarTexto(resumoAtual.mensagemCliente, \'btnCopiarMsg\')">Copiar mensagem</button></div>';
    html += '<div class="campo"><textarea rows="14" ' + dis + ' oninput="atualizarCampoResumo([\'mensagemCliente\'], this.value)">' + escaparHtml(r.mensagemCliente) + '</textarea></div>';
    html += enviado
      ? '<div class="btn btn-secundario">✓ Enviado ao cliente</div>'
      : '<button class="btn btn-primario" onclick="aprovarEnviar()">Aprovar e enviar ao cliente</button>';
    html += '<p class="aviso">Assim que o e-mail do convite for vinculado ao contato no CRM, este resumo vai automaticamente para o campo de observação do negócio no HubSpot.</p>';
    html += '</div>';

    html += '<div>';
    html += '<label style="font-size:11px;font-weight:600;color:var(--navy);display:block;margin-bottom:6px;">Próximos passos</label>';
    html += '<div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px;">';
    passosAtuais.forEach(function (p, i) {
      html += '<label class="passo' + (p.feito ? ' feito' : '') + '"><input type="checkbox" ' + (p.feito ? 'checked' : '') + ' onchange="passosAtuais[' + i + '].feito = this.checked; renderizarDetalhe();">' + escaparHtml(p.texto) + '</label>';
    });
    html += '</div>';
    html += '<button class="btn btn-secundario" disabled title="Em breve" style="margin-top:10px;">Criar tarefas no HubSpot (em breve)</button>';
    html += '<p class="aviso">Checklist só para acompanhamento interno por enquanto.</p>';
    html += '</div>';
    html += '</div>';

    el.innerHTML = html;
  }
</script>
</body>
</html>
