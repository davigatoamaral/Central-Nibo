function CopyButton({ text, label }) {
  const [copiado, setCopiado] = useState(false);
  const [falhou, setFalhou] = useState(false);

  function copiarFallback() {
    try {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      textarea.style.top = "0";
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      const ok = document.execCommand("copy");
      document.body.removeChild(textarea);
      return ok;
    } catch (e) {
      return false;
    }
  }

  async function copiar(e) {
    e.preventDefault();
    e.stopPropagation();
    setFalhou(false);
    let sucesso = false;

    if (navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        sucesso = true;
      } catch (err) {
        sucesso = false;
      }
    }

    if (!sucesso) {
      sucesso = copiarFallback();
    }

    if (sucesso) {
      setCopiado(true);
      setTimeout(() => setCopiado(false), 1500);
    } else {
      setFalhou(true);
      setTimeout(() => setFalhou(false), 2500);
    }
  }

  return (
    <button
      onClick={copiar}
      title={falhou ? `Não foi possível copiar — copie manualmente: ${text}` : label || "Copiar"}
      className="inline-flex items-center gap-1 text-xs px-1.5 py-0.5 rounded transition-colors flex-shrink-0"
      style={{
        color: falhou ? tokens.red : copiado ? tokens.brand : tokens.navySoft,
        backgroundColor: falhou ? tokens.redSoft : copiado ? tokens.brandSoft : "transparent",
      }}
    >
      {falhou ? <AlertCircle size={12} /> : copiado ? <Check size={12} /> : <Copy size={12} />}
      {falhou ? "Selecione manualmente" : copiado ? "Copiado" : ""}
    </button>
  );
}

function formatarDataLabel(date) {
  const hoje = new Date();
  const amanha = new Date();
  amanha.setDate(hoje.getDate() + 1);
  const mesmoDiaLocal = (a, b) =>
    a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();

  if (mesmoDiaLocal(date, hoje)) return "Hoje";
  if (mesmoDiaLocal(date, amanha)) return "Amanhã";
  return date.toLocaleDateString("pt-BR", { weekday: "short", day: "2-digit", month: "short" });
}

function paraInputDate(date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}-${m}-${d}`;
}

function getSemana(date) {
  const dia = date.getDay();
  const inicioSemana = new Date(date);
  inicioSemana.setDate(date.getDate() - dia);
  return Array.from({ length: 7 }, (_, i) => {
    const d = new Date(inicioSemana);
    d.setDate(inicioSemana.getDate() + i);
    return d;
  });
}

const diasAbrev = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];

function mesmoDia(a, b) {
  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
}

